# Copy to .env (never commit .env). Used by docker-compose and read by the API.

# Neo4j credentials (password must be >= 8 characters)
NEO4J_PASSWORD=change-me-please
NEO4J_USER=neo4j
NEO4J_URI=bolt://localhost:7687
NEO4J_DATABASE=neo4j

# Path to the YAML config (default: config/config.yaml relative to the working directory)
HFI_CONFIG=config/config.yaml
